{
	"name": "transform_to_presentation",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Json_injested",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Json_presentation",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "flattenRaces"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          MRData as (RaceTable as (Races as (Circuit as (Location as (country as string, lat as string, locality as string, long as string), circuitId as string, circuitName as string, url as string), date as string, raceName as string, round as string, season as string, url as string)[]), limit as string, offset as string, series as string, total as string, url as string, xmlns as string)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'documentPerLine') ~> source1",
				"source1 foldDown(unroll(MRData.RaceTable.Races),",
				"     mapColumn(",
				"          Circuit = MRData.RaceTable.Races.Circuit,",
				"          date = MRData.RaceTable.Races.date,",
				"          raceName = MRData.RaceTable.Races.raceName,",
				"          round = MRData.RaceTable.Races.round,",
				"          season = MRData.RaceTable.Races.season,",
				"          raceUrl = MRData.RaceTable.Races.url,",
				"          limit = MRData.limit,",
				"          offset = MRData.offset,",
				"          series = MRData.series,",
				"          total = MRData.total,",
				"          apiUrl = MRData.url,",
				"          xmlns = MRData.xmlns",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flattenRaces",
				"flattenRaces select(mapColumn(",
				"          Circuit,",
				"          date,",
				"          raceName,",
				"          round,",
				"          season,",
				"          raceUrl,",
				"          limit,",
				"          offset,",
				"          series,",
				"          total,",
				"          apiUrl,",
				"          xmlns",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}