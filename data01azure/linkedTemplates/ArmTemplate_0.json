																	},
																	"locality": {
																		"type": "string"
																	},
																	"long": {
																		"type": "string"
																	}
																}
															},
															"circuitId": {
																"type": "string"
															},
															"circuitName": {
																"type": "string"
															},
															"url": {
																"type": "string"
															}
														}
													},
													"date": {
														"type": "string"
													},
													"raceName": {
														"type": "string"
													},
													"round": {
														"type": "string"
													},
													"season": {
														"type": "string"
													},
													"url": {
														"type": "string"
													}
												}
											}
										}
									}
								},
								"limit": {
									"type": "string"
								},
								"offset": {
									"type": "string"
								},
								"series": {
									"type": "string"
								},
								"total": {
									"type": "string"
								},
								"url": {
